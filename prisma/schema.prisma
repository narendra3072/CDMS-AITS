generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  name          String
  role          String    @default("student") // admin, faculty, student
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  student       Student?
  faculty       Faculty?
  notifications NotificationRecipient[]
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  hodId       String?  @unique
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  hod         Faculty?  @relation("DepartmentHOD", fields: [hodId], references: [id])
  faculties   Faculty[] @relation("DepartmentFaculties")
  students    Student[] @relation("DepartmentStudents")
  programs    Program[]
  subjects    Subject[]
}

model Program {
  id           String   @id @default(cuid())
  name         String
  code         String
  duration     Int      @default(4) // years
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students     Student[]
}

model Subject {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  departmentId String
  semester     Int      @default(1)
  isCore       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  enrollmentNo String  @unique
  departmentId String
  programId    String?
  semester     Int      @default(1)
  year         Int      @default(1)
  section      String   @default("A")
  phone        String?
  address      String?
  dob          DateTime?
  gender       String?
  bloodGroup   String?
  guardianName String?
  guardianPhone String?
  admissionDate DateTime @default(now())
  status       String   @default("active") // active, graduated, dropped, suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department @relation("DepartmentStudents", fields: [departmentId], references: [id])
  program     Program?   @relation(fields: [programId], references: [id])
  documents   Document[]
  attendanceRecords AttendanceRecord[]
}

model Faculty {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeId   String   @unique
  departmentId String
  designation  String?
  specialization String?
  qualification String?
  experience   Int      @default(0) // years
  phone        String?
  address      String?
  dob          DateTime?
  gender       String?
  joinDate     DateTime @default(now())
  status       String   @default("active") // active, on_leave, retired, resigned
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department @relation("DepartmentFaculties", fields: [departmentId], references: [id])
  departments Department[] @relation("DepartmentHOD")
  markedAttendance AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  facultyId String
  date      DateTime
  subject   String
  status    String   @default("present") // present, absent, late
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, subject])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String   // transcript, certificate, id_proof, other
  fileUrl   String
  studentId String
  uploadedAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, urgent, event
  targetRole String? // null = all, admin, faculty, student
  createdBy String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients NotificationRecipient[]
}

model NotificationRecipient {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  isRead         Boolean  @default(false)
  readAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  title       String
  type        String   // student, faculty, department, attendance, performance
  format      String   // pdf, excel, csv
  generatedBy String
  fileUrl     String?
  parameters  String?  // JSON string of filters
  createdAt   DateTime @default(now())
}
